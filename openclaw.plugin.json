{
  "id": "notion-plugin",
  "name": "Notion Integration Plugin",
  "description": "Enables direct integration with a Notion workspace for OpenClaw Agents.",
  "version": "0.1.1",
  "configSchema": {
    "type": "object",
    "required": [
      "api_key"
    ],
    "properties": {
      "api_key": {
        "type": "string"
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "notion-search",
      "get-database",
      "get-page",
      "create-page"
    ]
  }
}
